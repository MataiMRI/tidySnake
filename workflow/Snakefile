configfile: 'config/config.yaml'

from pathlib import Path
from itertools import chain
from bids import BIDSLayout
from snakemake.io import touch
include: "utils.py"  # useful for workflows importing this one

RESULTS_DIR = config["resultsdir"].rstrip("/")
BIDS_ROOT   = f"{RESULTS_DIR}/bids"
USE_EXISTING_BIDS = config.get("use_existing_bids", False)
print("USE_EXISTING_BIDS:", USE_EXISTING_BIDS)

def list_scans(root_folder, prefix):
    mapping = {}

    for path in Path(root_folder).glob(f"{prefix}*"):
        if not path.is_dir() and not path.suffix == ".zip":
            print(f"Ignoring {path} (not a folder or a .zip file).")
            continue

        infos = [s.lower() for s in path.stem.replace(prefix, "").split("_")]
        if len(infos) == 2:
            infos += ["a"]

        if len(infos) != 3:
            print(f"Ignoring {path} (wrong filename format).")
            continue

        cohort, subject, session = infos

        if path.is_dir():
            mapping[(cohort + subject, session)] = path
        else:
            mapping[(cohort + subject, session)] = path.with_suffix("")

    return mapping

def list_pairs_from_bids(bids_root, suffix="T1w"):
    """
    Return sorted list of (subject, session) pairs that have the given suffix.
    Only includes sessioned data.
    """
    layout = BIDSLayout(bids_root, validate=False, derivatives=False)

    pairs = set()
    files = layout.get(suffix=suffix, extension=[".nii", ".nii.gz"])
    for f in files:
        ent = f.entities
        sub = ent.get("subject")
        ses = ent.get("session")
        if sub and ses:
            pairs.add((sub, ses))

    return sorted(pairs)


