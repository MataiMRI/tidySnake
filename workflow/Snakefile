        "--command populate-templates"

def get_task(wildcards):
    entities = dict(entity.split("-") for entity in wildcards.entity.split("_"))
    if "task" in entities:
        flag = f"--task-id {entities['task']}"
    else:
        flag = ""
    return flag

def get_run(wildcards):
    entities = dict(entity.split("-") for entity in wildcards.entity.split("_"))
    if "run" in entities:
        flag = f"--run-id {entities['run']}"
    else:
        flag = ""
    return flag

