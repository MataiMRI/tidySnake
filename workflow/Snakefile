if not USE_EXISTING_BIDS:
    rule unzip:
        input:
            f"{config['datadir']}/{{folder}}.zip"
        output:
            directory(f"{config['datadir']}/{{folder}}")
        wildcard_constraints:
            folder="(.(?!\.zip))+"  # avoid recursive .zip matching in folder name
        shell:
            "unzip -q -d {output} {input}"

    # rule tidy_dicoms:
    #     input:
    #         lambda wildards: MAPPING[(wildards.subject, wildards.session)]
    #     output:
    #         touch("{resultsdir}/tidy/sub_{subject}/ses_{session}/.ready")
    # #        temp(directory("{resultsdir}/tidy/sub_{subject}/ses_{session}")),
    #     run:
    #         output_folder = Path(output[0]).parent
    #         for dicom_file in Path(input[0]).rglob("*.dcm"):
    #             target_folder = output_folder / dicom_file.parent.name
    #             target_folder.mkdir(parents=True, exist_ok=True)
    #             (target_folder / dicom_file.name).symlink_to(dicom_file)

    rule tidy_dicoms:
        input:
            lambda wildcards: MAPPING[(wildcards.subject, wildcards.session)]
        output:
            touch("{resultsdir}/tidy/sub_{subject}/ses_{session}/.ready")
        run:
            from pathlib import Path

            scanner = config.get("scanner", "ge").lower()
            output_folder = Path(output[0]).parent
            in_root = Path(input[0])

            for dicom_file in in_root.rglob("*.dcm"):

                if scanner == "ge":
                    # Original GE behaviour: parent folder is the series
                    series_folder = dicom_file.parent.name

                elif scanner == "siemens":
                    # Siemens export: series is the folder after ACQUISITIONS
                    parts = dicom_file.parts
                    if "ACQUISITIONS" in parts:
                        i = parts.index("ACQUISITIONS")
                        if i + 1 < len(parts):
                            series_folder = parts[i + 1]
                        else:
                            series_folder = dicom_file.parent.name
                    else:
                        # Fallback if layout is unexpected
                        series_folder = dicom_file.parent.name

                else:
                    raise ValueError(f"Unknown scanner type: {scanner}")

                target_folder = output_folder / series_folder
                target_folder.mkdir(parents=True, exist_ok=True)

                dst = target_folder / dicom_file.name
                if dst.exists() or dst.is_symlink():
                    continue

                dst.symlink_to(dicom_file)


    checkpoint heudiconv:
        input:
    #       "{resultsdir}/tidy/sub_{subject}/ses_{session}"
            "{resultsdir}/tidy/sub_{subject}/ses_{session}/.ready"
        output:
            directory("{resultsdir}/bids/sub-{subject}/ses-{session}"),
            directory("{resultsdir}/bids/.heudiconv/{subject}/ses-{session}")
        container: config['containers']['heudiconv']
    #        "docker://ghcr.io/mataimri/heudiconv:container_ci"
        threads: config["heudiconv"]["threads"]
        resources:
            cpus=lambda wildcards, threads: threads,
            mem_mb=config["heudiconv"]["mem_mb"],
            runtime=config["heudiconv"]["time_min"]
        params:
            grouping=config["heudiconv"].get("grouping", "studyUID")
        shell:
            "heudiconv "
            "--dicom_dir_template '{wildcards.resultsdir}/tidy/sub_{{subject}}/ses_{{session}}/*/*' "
            "--outdir {wildcards.resultsdir}/bids "
            "--heuristic {config[heudiconv][heuristic]} "
            "--subjects {wildcards.subject} "
            "--ses {wildcards.session} "
            "--grouping {params.grouping} "
            "--converter dcm2niix "
            "--bids notop "
            "--overwrite"

