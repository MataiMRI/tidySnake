# profiles/gadi/snakemake.pbs
#!/usr/bin/env bash
#PBS -P wn97
#PBS -q normal
#PBS -l ncpus=2,mem=4GB,walltime=04:00:00
#PBS -l wd
#PBS -N tidySnake
#PBS -j oe
#PBS -o /scratch/wn97/data/logs/
#PBS -l storage=gdata/wn97+scratch/wn97

set -euo pipefail
mkdir -p /scratch/wn97/data/logs/

module purge 2>/dev/null || true
module load singularity
module load python3/3.11.0
source /g/data/wn97/venvs/snakemake-9.7/bin/activate

export SINGULARITY_CACHEDIR=/scratch/$PROJECT/$USER/singularity_cache
export SINGULARITY_TMPDIR=/scratch/$PROJECT/$USER/singularity_tmp
mkdir -p "$SINGULARITY_CACHEDIR" "$SINGULARITY_TMPDIR" || true

ACCOUNT="${NCI_PROJECT:-wn97}"

SUB='qsub -P wn97 -q normal -N tidySnake-{rule} \
-l ncpus={threads},mem={resources.mem_mb}mb,walltime=00:{resources.runtime}:00,storage=gdata/wn97+scratch/wn97 \
-l wd -j oe -o /scratch/wn97/data/logs/{rule}.{jobid}.out'

snakemake \
  --profile profiles/gadi \
  --cluster-generic-submit-cmd "$SUB" \
  --config account="$ACCOUNT" \
  ${SMK_ARGS:-} \
  "$@"  

